<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>CryptoConexPC</AssemblyName>
    <RootNamespace>CryptoConexPC</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <Product>APP DE SUPORTE TÉCNICO</Product>
    <Company>Crypto Conex</Company>
    <ConexBackendUrl Condition="'$(ConexBackendUrl)' == ''">https://SEU-DOMINIO.pt</ConexBackendUrl>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BackendUrl" Value="$(ConexBackendUrl)" />
    <EmbeddedResource Include="logo.png" />
    <None Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="SIPSorceryMedia.Encoders" Version="10.0.4" />
    <PackageReference Include="SocketIOClient" Version="3.1.2" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
  </ItemGroup>
</Project>
